{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "src/types.d.ts",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "./yet-another-media-player.js"
  ]
}
